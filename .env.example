# MySQL: database created by npm run db:init; TLS verification enabled.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=jusigi
DB_USER=
DB_PASSWORD=
# Optional CA PEM path for a private CA (never disables certificate verification).
DB_SSL_CA=
# Only local loopback test databases may disable TLS.
DB_TLS=true
# New loan tranches mature after 7 days by default; existing deadlines stay fixed.
LOAN_TERM_DAYS=7
# Redis TLS cache, optional; cache failure falls back to MySQL.
REDIS_HOST=
REDIS_PORT=10000
REDIS_ACCESS_KEY=
# Discord login and slash-command deployment.
TOKEN=
APPLICATION_ID=
# Optional AI news provider; default local fictional news keeps the game working.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_MODEL=gpt-5-nano
# Default 5 minutes; stored in market state when scheduling each update.
STOCK_UPDATE_INTERVAL_MS=300000
